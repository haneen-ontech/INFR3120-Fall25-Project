<%- include ../partials/header.ejs %> <!--Header-->
<%- include ../partials/main_nav.ejs %> <!--Main Navigation-->

<!--Content for adding the record-->
<div class="container my-5"> <!--Main container-->
  <div class="row"> 
    <div class="offset-md-3 col-md-6"> <!--Center form on screen as well as allow for fluidity-->

      <div class="card mx-auto" style="min-height: 500px; background-color: #113675; box-shadow: 0 0 20px #FADB2d;"> <!--Card with styling-->
        <div class="card-body text-center" style="padding-top: 40px;"> <!--Card body-->
          <h1 class="text-center mb-4" style="font-weight: bold; color: white;"><%= title %></h1> <!--Page title retrieved from server-->
          <div class="mx-auto" style="width: 100%; max-width: 450px;"> <!--Form container with max width-->

            <form class="form" method="post"> <!--Form to add a new record-->

              <!--Name-->
              <div class="form-group mb-2">
                <label for="nameTextField" style="color: white">Name</label> <!--Name input field-->
                <input type="text" class="form-control" id="nameTextField" 
                       placeholder="Enter first & last name" name="name" required /> <!--Type is text with a placeholder-->
              </div> 
              <!--Insurance Number-->
              <div class="form-group mb-2"> <!--Insurance number input field-->
                <label for="insuranceNumTextField" style="color: white">Insurance Number</label> <!--Label-->
                <input type="text" class="form-control" id="insuranceNumTextField"
                       placeholder="Enter Insurance Number" name="insuranceNum" required /> <!--Type is text with a placeholder-->
              </div>
              <!--Description-->
              <div class="form-group mb-2"> <!--Description input field-->
                <label for="descriptionTextField" style="color: white">Description</label> <!--Description input field-->
                <textarea class="form-control" id="descriptionTextField"
                          placeholder="Enter the description of the incident"
                          name="description" required></textarea> <!--the <textarea> tag doesn't have a value key word so the current value is stored between the opening and closing tag-->
              </div>
              <!--Date-->
              <div class="form-group mb-2"> <!--Date input field-->
                <label for="dateField" style="color: white">Date</label> <!--Label-->
                <input type="date" class="form-control" id="dateField" name="date" required /> <!--Type is date which by default provides a lot of information about the date and time, to keep it simple with just year/month/day information, we use the toIOSString function to split and only take needed information from the date object-->
              </div>
              <!--Car Model-->
              <div class="form-group mb-2"> <!--Car model input field-->
                <label for="carModelTextField" style="color: white">Car Model</label> <!--Label-->
                <input type="text" class="form-control" id="carModelTextField"
                       placeholder="Enter the Car Model" name="carModel" required /> <!--Type is text with a placeholder-->
              </div>
              <!--License Plate-->
              <div class="form-group mb-2"> <!--License plate input field-->
                <label for="licencePlateTextField" style="color: white">Licence Plate</label> <!--Label-->
                <input type="text" class="form-control" id="licensePlateTextField"
                       placeholder="Enter the license plate" name="licensePlate" required /> <!--Type is text with a placeholder-->
              </div>
              <br />
              <!--Submit button-->
              <button class="btn btn-primary" type="submit">
                <i class="fas fa-edit"></i> Submit
              </button>
              <!--Cancel button-->
              <a href="/records" class="btn btn-warning">
                <i class="fas fa-undo"></i> Cancel
              </a>
              <br>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include ../partials/footer.ejs %> <!--Footer-->
